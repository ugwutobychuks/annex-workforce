# ───────── Database ─────────
DATABASE_URL=postgresql://annex:annexpass@postgres:5432/annex
POSTGRES_USER=annex
POSTGRES_PASSWORD=annexpass
POSTGRES_DB=annex

# ───────── Redis ─────────
REDIS_URL=redis://:redispass@redis:6379
REDIS_PASSWORD=redispass

# ───────── Elasticsearch ─────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ───────── Object Storage (S3 / MinIO) ─────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=annexminio
S3_SECRET_KEY=miniopassword
S3_BUCKET=annex-documents
S3_FORCE_PATH_STYLE=true

# ───────── JWT ─────────
JWT_SECRET=your-production-jwt-secret-change-me-32-chars-min
JWT_REFRESH_SECRET=your-production-refresh-secret-change-me-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ───────── API ─────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=production
ALLOWED_ORIGINS=http://98.84.56.161:3000,http://localhost:3000,http://app.local

# ───────── Web ─────────
NEXT_PUBLIC_API_URL=http://98.84.56.161:4000
NEXT_PUBLIC_APP_NAME=Annex Workforce
WEB_APP_URL=http://98.84.56.161:3000

# ───────── Third-party (optional) ─────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@annexworkforce.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
