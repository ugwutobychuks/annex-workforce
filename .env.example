# ───────── Database ─────────
DATABASE_URL=postgresql://annex:annexpass@localhost:5432/annex
POSTGRES_USER=annex
POSTGRES_PASSWORD=annexpass
POSTGRES_DB=annex

# ───────── Redis ─────────
REDIS_URL=redis://:redispass@localhost:6379
REDIS_PASSWORD=redispass

# ───────── Elasticsearch ─────────
ELASTICSEARCH_URL=http://localhost:9200

# ───────── Object Storage (S3 / MinIO) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=annexminio
S3_SECRET_KEY=miniopassword
S3_BUCKET=annex-documents
S3_FORCE_PATH_STYLE=true

# ───────── JWT ─────────
JWT_SECRET=replace-with-32-char-random-string-in-prod
JWT_REFRESH_SECRET=replace-with-different-32-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ───────── API ─────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ───────── Web ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Annex Workforce

# URL the API uses to build links inside outbound emails
# (e.g. "Click here to verify" → ${WEB_APP_URL}/verify-email?token=...)
WEB_APP_URL=http://localhost:3000

# ───────── Third-party (fill for prod) ─────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@annexworkforce.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
