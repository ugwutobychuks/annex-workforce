# ── Convex ─────────────────────────────────────────────────────────────────
# Get these by running `npx convex dev` once; it will prompt you to create
# a free Convex project and write both variables into .env.local for you.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=

# ── Convex Auth ────────────────────────────────────────────────────────────
# Run `npx @convex-dev/auth --production=false` once and it will populate
# JWT_PRIVATE_KEY and JWKS in your Convex dashboard's env vars.

# Site URL used by Convex Auth for callbacks. In local dev this is the
# Vite dev server (default port 5173).
SITE_URL=http://localhost:5173
