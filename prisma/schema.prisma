// ──────────────────────────────────────────────────────────────
//  Annex Workforce — Prisma Schema
//  Covers: Auth · Talent · Marketplace · EOR · HRMS · Payroll
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══ ENUMS ════════════════════════════════════════════════════

enum UserRole {
  CANDIDATE
  EMPLOYER
  HR_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  IDENTITY_VERIFIED
  CREDENTIALS_VERIFIED
  FULLY_VERIFIED
}

enum AvailabilityStatus {
  IMMEDIATELY
  WITHIN_2_WEEKS
  WITHIN_MONTH
  PASSIVELY_LOOKING
  NOT_LOOKING
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
}

enum SeniorityLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  FILLED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum EorContractStatus {
  PENDING
  ACTIVE
  TERMINATED
  EXPIRED
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  COMPASSIONATE
  UNPAID
  STUDY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ═══ AUTH & USERS ═════════════════════════════════════════════

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(CANDIDATE)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  phone         String?
  phoneVerified Boolean    @default(false)
  firstName     String
  lastName      String
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  candidate         Candidate?
  employer          EmployerMembership[]
  refreshTokens     RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══ CANDIDATES (TALENT) ══════════════════════════════════════

model Candidate {
  id                  String              @id @default(uuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline            String?             // e.g. "Senior Backend Engineer"
  summary             String?             @db.Text
  location            String?             // City, State
  country             String              @default("NG")
  nationalIdNumber    String?             // NIN
  bvn                 String?             // hashed
  dateOfBirth         DateTime?
  gender              String?
  yearsOfExperience   Int                 @default(0)
  currentSalary       Decimal?            @db.Decimal(12, 2)
  expectedSalary      Decimal?            @db.Decimal(12, 2)
  salaryCurrency      String              @default("NGN")
  availability        AvailabilityStatus  @default(PASSIVELY_LOOKING)
  willingToRelocate   Boolean             @default(false)
  remotePreference    WorkArrangement     @default(HYBRID)
  verificationLevel   VerificationLevel   @default(UNVERIFIED)
  resumeUrl           String?
  linkedinUrl         String?
  githubUrl           String?
  portfolioUrl        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  skills        CandidateSkill[]
  experiences   WorkExperience[]
  educations    Education[]
  certifications Certification[]
  documents     CandidateDocument[]
  applications  Application[]
  verifications VerificationRecord[]

  @@index([location])
  @@index([availability])
  @@index([verificationLevel])
  @@map("candidates")
}

model Skill {
  id        String           @id @default(uuid())
  name      String           @unique
  category  String           // "Programming", "Design", "Sales", etc.
  createdAt DateTime         @default(now())
  candidates CandidateSkill[]
  jobSkills  JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id])
  level       Int       @default(3) // 1-5 self-rated
  yearsExp    Int       @default(0)
  endorsed    Boolean   @default(false)

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

model WorkExperience {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  description String?   @db.Text
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("work_experiences")
}

model Education {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  fieldOfStudy String?
  startYear   Int
  endYear     Int?
  grade       String?
  createdAt   DateTime  @default(now())

  @@map("educations")
}

model Certification {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  issuer      String
  issuedDate  DateTime
  expiryDate  DateTime?
  credentialId String?
  credentialUrl String?
  verified    Boolean   @default(false)

  @@map("certifications")
}

model CandidateDocument {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String    // "RESUME", "ID_CARD", "DEGREE_CERT", etc.
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  uploadedAt  DateTime  @default(now())

  @@map("candidate_documents")
}

// ═══ VERIFICATION ═════════════════════════════════════════════

model VerificationRecord {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String    // "IDENTITY", "EDUCATION", "EMPLOYMENT", "BACKGROUND"
  provider    String    // "smile_identity", "youverify", "manual"
  status      String    // "PENDING", "VERIFIED", "FAILED"
  result      Json?
  initiatedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([candidateId])
  @@map("verification_records")
}

// ═══ EMPLOYERS ════════════════════════════════════════════════

model Employer {
  id              String      @id @default(uuid())
  name            String
  legalName       String?
  industry        String?
  size            String?     // "1-10", "11-50", "51-200", etc.
  website         String?
  logoUrl         String?
  description     String?     @db.Text
  hqCountry       String      @default("NG")
  hqCity          String?
  rcNumber        String?     // Nigeria CAC RC number
  taxId           String?
  isVerified      Boolean     @default(false)
  subscriptionTier String     @default("FREE") // FREE | PRO | ENTERPRISE
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  members      EmployerMembership[]
  jobs         Job[]
  eorContracts EorContract[]

  @@map("employers")
}

model EmployerMembership {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  role       String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt  DateTime @default(now())

  @@unique([userId, employerId])
  @@map("employer_memberships")
}

// ═══ MARKETPLACE: JOBS ════════════════════════════════════════

model Job {
  id              String          @id @default(uuid())
  employerId      String
  employer        Employer        @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title           String
  description     String          @db.Text
  responsibilities String?        @db.Text
  requirements    String?         @db.Text
  benefits        String?         @db.Text
  location        String?
  country         String          @default("NG")
  workArrangement WorkArrangement @default(ONSITE)
  employmentType  EmploymentType  @default(FULL_TIME)
  seniority       SeniorityLevel  @default(MID)
  salaryMin       Decimal?        @db.Decimal(12, 2)
  salaryMax       Decimal?        @db.Decimal(12, 2)
  salaryCurrency  String          @default("NGN")
  status          JobStatus       @default(DRAFT)
  publishedAt     DateTime?
  closesAt        DateTime?
  isEor           Boolean         @default(false) // managed-hiring flag
  views           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  skills        JobSkill[]
  applications  Application[]

  @@index([status])
  @@index([country])
  @@index([publishedAt])
  @@map("jobs")
}

model JobSkill {
  id        String  @id @default(uuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id])
  required  Boolean @default(true)
  minLevel  Int     @default(3)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?           @db.Text
  resumeUrl   String?
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  notes       Json?             // recruiter notes timeline

  @@unique([jobId, candidateId])
  @@index([status])
  @@map("applications")
}

// ═══ EOR (Employer of Record) ═════════════════════════════════

model EorContract {
  id              String            @id @default(uuid())
  employerId      String
  employer        Employer          @relation(fields: [employerId], references: [id])
  candidateUserId String            // the candidate becomes the employee
  status          EorContractStatus @default(PENDING)
  jobTitle        String
  monthlySalary   Decimal           @db.Decimal(12, 2)
  currency        String            @default("NGN")
  startDate       DateTime
  endDate         DateTime?
  probationMonths Int               @default(3)
  managementFee   Decimal           @db.Decimal(12, 2)
  contractFileUrl String?
  signedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payslips Payslip[]

  @@index([employerId])
  @@index([candidateUserId])
  @@map("eor_contracts")
}

// ═══ PAYROLL ══════════════════════════════════════════════════

model PayrollRun {
  id          String           @id @default(uuid())
  employerId  String
  period      String           // "2025-05"
  status      PayrollRunStatus @default(DRAFT)
  totalGross  Decimal          @db.Decimal(14, 2) @default(0)
  totalNet    Decimal          @db.Decimal(14, 2) @default(0)
  totalTax    Decimal          @db.Decimal(14, 2) @default(0)
  totalPension Decimal         @db.Decimal(14, 2) @default(0)
  approvedBy  String?
  approvedAt  DateTime?
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  payslips Payslip[]

  @@unique([employerId, period])
  @@map("payroll_runs")
}

model Payslip {
  id           String      @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  contractId   String
  contract     EorContract @relation(fields: [contractId], references: [id])
  grossSalary  Decimal     @db.Decimal(12, 2)
  payeTax      Decimal     @db.Decimal(12, 2) // Pay-As-You-Earn
  pension      Decimal     @db.Decimal(12, 2)
  nhf          Decimal     @db.Decimal(12, 2) // National Housing Fund
  otherDeductions Decimal  @db.Decimal(12, 2) @default(0)
  netSalary    Decimal     @db.Decimal(12, 2)
  pdfUrl       String?
  createdAt    DateTime    @default(now())

  @@map("payslips")
}

// ═══ HRMS: LEAVE ══════════════════════════════════════════════

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String      // user id of employee
  employerId    String
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  daysRequested Int
  reason        String?     @db.Text
  status        LeaveStatus @default(PENDING)
  approverId    String?
  approverNote  String?
  createdAt     DateTime    @default(now())
  decidedAt     DateTime?

  @@index([employeeId])
  @@index([employerId])
  @@map("leave_requests")
}

model LeaveBalance {
  id           String   @id @default(uuid())
  employeeId   String
  employerId   String
  type         LeaveType
  year         Int
  entitled     Int
  used         Int      @default(0)
  carriedOver  Int      @default(0)

  @@unique([employeeId, type, year])
  @@map("leave_balances")
}
